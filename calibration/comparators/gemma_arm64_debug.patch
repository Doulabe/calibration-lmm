--- src/debug.cpp.orig	2026-10-01 02:31:05
+++ src/debug.cpp	2026-10-01 02:31:05
@@ -97,6 +97,13 @@
 
 inline int feenableexcept(unsigned int excepts)
 {
+#if defined(__aarch64__) || defined(__arm64__)
+    // arm64 (Apple Silicon): fenv_t has no x87/SSE fields. Floating-point
+    // exception trapping is a debugging aid only and is skipped (no effect on
+    // any statistical computation).
+    (void)excepts;
+    return 0;
+#else
     static fenv_t fenv;
     unsigned int new_excepts = excepts & FE_ALL_EXCEPT;
     // previous masks
@@ -112,10 +119,15 @@
     fenv.__mxcsr   &= ~(new_excepts << 7);
 
     return fesetenv(&fenv) ? -1 : old_excepts;
+#endif
 }
 
 inline int fedisableexcept(unsigned int excepts)
 {
+#if defined(__aarch64__) || defined(__arm64__)
+    (void)excepts;
+    return 0;
+#else
     static fenv_t fenv;
     unsigned int new_excepts = excepts & FE_ALL_EXCEPT;
     // all previous masks
@@ -131,6 +143,7 @@
     fenv.__mxcsr   |= new_excepts << 7;
 
     return fesetenv(&fenv) ? -1 : old_excepts;
+#endif
 }
 
 #endif
